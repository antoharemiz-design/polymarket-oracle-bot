# ==============================================================================
# Polymarket API Credentials
# ==============================================================================
# Приватный ключ от кошелька (0x...)
POLYMARKET_PRIVATE_KEY=your_private_key_here

# Адрес кошелька-финансировщика (0x...)
FUNDER_ADDRESS=your_funder_address_here

# ==============================================================================
# Gasless Relayer (опционально — для бесплатного redeem)
# ==============================================================================
# API ключ релеера
POLYMARKET_RELAYER_KEY=your_relayer_key_here

# Адрес релеера
POLYMARKET_RELAYER_ADDRESS=your_relayer_address_here