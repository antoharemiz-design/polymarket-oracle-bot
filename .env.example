# ---- Credentials (live mode only; paper mode needs none of these) ------------------------
# Private key of the signer (0x...)
POLYMARKET_PRIVATE_KEY=
# Polymarket account wallet that holds the funds (the address shown in your profile)
FUNDER_ADDRESS=
# Relayer API key from polymarket.com -> Settings -> API Keys -> Relayer API Keys (gasless redeem)
POLYMARKET_RELAYER_KEY=
POLYMARKET_RELAYER_ADDRESS=

# ---- Bot ---------------------------------------------------------------------------------
BOT_ASSET=btc
BOT_TF=5m
# "taker" (fast spot signal, the candidate from research/03) or "maker" (post-only quotes; loses in backtest)
BOT_STRATEGY=taker
# Taker: required edge after fee, in cents
BOT_TAKER_THETA=1.0
# Spot source: coinbase (default) or binance
BOT_SPOT_SOURCE=coinbase
BOT_JOURNAL_DIR=journal
# Paper mode only: assumed round trip of every order action, and queue pessimism
BOT_LAT_MS=150
BOT_QUEUE_MULT=1.0
# Live mode: exchange-side dead-man switch. Once the first heartbeat is accepted it cannot be
# disarmed and it cancels ALL open orders of this API key if the bot stops for 10 seconds.
BOT_HEARTBEAT=false

# ---- Strategy (defaults are in polybot/strategy.py) --------------------------------------
# Pre-registered maker candidate (research/06_maker_inventory.md, step 2.5). NOT validated.
# BOT_STRATEGY=maker
# STRAT_SKEW=1.0
# STRAT_FAST_MS=500
# STRAT_MOM_S=60
# STRAT_MOM_W=0.2
STRAT_CLIP=5
STRAT_MAX_NET=25
STRAT_MAX_GROSS=100

# ---- Risk --------------------------------------------------------------------------------
# Stop for the rest of the UTC day at this realized loss, in dollars
RISK_DAILY_STOP_USD=10
# Maximum dollars committed to markets that have not resolved yet
RISK_MAX_OPEN_USD=100

# ---- Liquidity-rewards test (H10, polybot/lp.py; research/07_new_niches.md, section 8) ---------
# Defaults are the pre-registered test; change them only with a new pre-registration.
# LP_LP_DIR=journal/lp
# LP_MARKETS_MIN=5
# LP_MARKETS_MAX=8
# LP_CAPITAL_USD=200
# LP_QUOTE_BUDGET_USD=100
# LP_POS_LIMIT_MULT=3
# LP_STOP_LOSS_USD=50
# LP_TEST_DAYS=7
# LP_SELECT_SNAPSHOTS=48           # selection: book snapshots (research/PREREG_LP_PHASE1B.md)
# LP_SELECT_GAP_S=1800             # 30 minutes apart: one day
# LP_MIN_COMP_LEVELS=3             # hard filter: median competitor levels in the reward zone
# LP_M1_PER_100_MIN=10             # H10 closes below this M1 ($/day per $100 of quotes, hours 24-48)

# ---- Server (VPS) — /etc/polybot/env, written by deploy/setup_vps.sh ---------------------------
# Paper needs nothing below the "live" line. Keys are entered on the server only: sudo polybot keys
POLYBOT_MODE=paper                 # paper | live (switch with: sudo polybot mode paper|live)
POLYBOT_ALLOW_LIVE=no              # set to yes only by "sudo polybot mode live" after typing LIVE
POLYBOT_BRANCH=main                # branch the server deploys; live runs only from main
POLYBOT_DATA=/var/lib/polybot
POLYBOT_MARKETS=                   # empty: markets are selected at the first start (48 snapshots, one day)
POLYBOT_REPORTS_REPO=git@github.com:OWNER/polybot-reports.git
POLYBOT_AUTO_UPDATE=yes            # no: the server stops auto-deploying (sudo polybot update still works)
LP_TEST_DAYS=2                     # phase 1: 48 hours
TELEGRAM_BOT_TOKEN=                # optional alerts: sudo polybot telegram
TELEGRAM_CHAT_ID=
# ---- live only (phase 2): entered with sudo polybot keys, never committed ----
# POLYMARKET_PRIVATE_KEY=
# FUNDER_ADDRESS=
# POLYMARKET_RELAYER_KEY=
# POLYMARKET_RELAYER_ADDRESS=
