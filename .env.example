# ---- Credentials (live mode only; paper mode needs none of these) ------------------------
# Private key of the signer (0x...)
POLYMARKET_PRIVATE_KEY=
# Polymarket account wallet that holds the funds (the address shown in your profile)
FUNDER_ADDRESS=
# Relayer API key from polymarket.com -> Settings -> API Keys -> Relayer API Keys (gasless redeem)
POLYMARKET_RELAYER_KEY=
POLYMARKET_RELAYER_ADDRESS=

# ---- Bot ---------------------------------------------------------------------------------
BOT_ASSET=btc
BOT_TF=5m
BOT_JOURNAL_DIR=journal
# Paper mode only: assumed round trip of every order action, and queue pessimism
BOT_LAT_MS=150
BOT_QUEUE_MULT=1.0
# Live mode: exchange-side dead-man switch. Once the first heartbeat is accepted it cannot be
# disarmed and it cancels ALL open orders of this API key if the bot stops for 10 seconds.
BOT_HEARTBEAT=false

# ---- Strategy (defaults are in polybot/strategy.py) --------------------------------------
STRAT_CLIP=5
STRAT_MAX_NET=25
STRAT_MAX_GROSS=100

# ---- Risk --------------------------------------------------------------------------------
# Stop for the rest of the UTC day at this realized loss, in dollars
RISK_DAILY_STOP_USD=10
# Maximum dollars committed to markets that have not resolved yet
RISK_MAX_OPEN_USD=100
